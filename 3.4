#include <iostream>
#include <iomanip>
using namespace std;

int main() {
    double peso;

    cout << "Enter Philippine peso: ";
    cin >> peso;

    double dollar = peso / 43.33089;
    double euro = peso / 58.97613918;
    double yuan = peso / 6.82705855;
    double koruna = peso / 2.30819496;
    double krone = peso / 7.95207090;
    double sheqel = peso / 11.62828936;
    double dinar = peso / 157.80329075;

    cout << fixed << setprecision(6);
    cout << "\nThe amount's equivalent to:\n";
    cout << "US Dollar : " << dollar << endl;
    cout << "Euro      : " << euro << endl;
    cout << "Yuan      : " << yuan << endl;
    cout << "Koruna    : " << koruna << endl;
    cout << "Krone     : " << krone << endl;
    cout << "Sheqel    : " << sheqel << endl;
    cout << "Dinar     : " << dinar << endl;

    return 0;
}
